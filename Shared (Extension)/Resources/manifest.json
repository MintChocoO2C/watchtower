{
    "manifest_version": 3,
    "default_locale": "en",

    "name": "__MSG_extension_name__",
    "description": "__MSG_extension_description__",
    "version": "1.4",

    "icons": {
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png",
        "512": "images/icon-512.png"
    },

    "background": {
        "scripts": [ "background.js" ],
        "type": "module"
    },

    "content_scripts": [
        {
            "js": [ "wt-core.js", "content.js", "speed.js", "adskip.js" ],
            "matches": [ "<all_urls>" ],
            "exclude_matches": [ "https://chzzk.naver.com/wt-room*" ],
            "run_at": "document_idle"
        },
        {
            "js": [ "wt-core.js", "adskip.js", "room.js" ],
            "css": [ "room.css" ],
            "matches": [ "https://chzzk.naver.com/wt-room*" ],
            "run_at": "document_start"
        },
        {
            "js": [ "page-script.js" ],
            "matches": [ "<all_urls>" ],
            "world": "MAIN",
            "run_at": "document_start"
        }
    ],

    "action": {
        "default_title": "__MSG_roomOpen__",
        "default_icon": "images/toolbar-icon.svg"
    },

    "permissions": [ "activeTab", "storage", "contextMenus", "clipboardWrite", "scripting" ],
    "host_permissions": [ "https://chzzk.naver.com/*" ]
}
